+    def _detect_dob_columns(self, df):
+        """Find date-of-birth-like columns by name."""
+        dob_cols = []
+        for column in df.columns:
+            lc = str(column).lower()
+            if re.search(r'\bdob\b', lc) or 'date of birth' in lc or 'birthdate' in lc or 'birth date' in lc:
+                dob_cols.append(column)
+        return dob_cols
+
+    def _detect_reference_date_column(self, df, exclude=None):
+        """Find a plausible 'as of' date column (collection/visit/assessment
+        date) to compute age against. Falls back to None (caller uses today)."""
+        exclude = exclude or set()
+        keywords = ('collection', 'visit', 'assessment', 'session', 'exam', 'interview')
+        for column in df.columns:
+            if column in exclude:
+                continue
+            lc = str(column).lower()
+            if 'date' in lc and any(k in lc for k in keywords):
+                return column
+        return None
+
+    @staticmethod
+    def _parse_age_bucket_bounds(label):
+        """Parse an age-grouping label like '10-19' or '40+' into (low, high).
+        high is None for an open-ended bucket. Returns None if unparseable."""
+        if label is None:
+            return None
+        s = str(label).strip()
+        m = re.match(r'^(\d+)\s*-\s*(\d+)$', s)
+        if m:
+            return int(m.group(1)), int(m.group(2))
+        m = re.match(r'^(\d+)\s*\+$', s)
+        if m:
+            return int(m.group(1)), None
+        return None
+
+    def reconcile_age_with_dob(self, df, table_name):
+        """Keep an Age column and a Date-of-Birth column mathematically
+        consistent after independent synthesis/perturbation.
+
+        If Age is still a plain number, it's recomputed from DOB (DOB is
+        treated as the source of truth) against a per-row reference date
+        when one can be found (a collection/visit/assessment date column),
+        otherwise today. If Age has already been converted to a range/bucket
+        (age grouping), the exact DOB is degraded to a matching birth-year
+        range instead -- an exact DOB sitting next to a bucketed age would
+        otherwise both contradict the bucket and leak more precision than
+        the bucket was meant to hide.
+        """
+        dob_cols = self._detect_dob_columns(df)
+        age_cols = [c for c in df.columns if re.search(r'\bage\b', str(c), re.IGNORECASE)]
+        if not dob_cols or not age_cols:
+            return df
+
+        result_df = df.copy()
+        dob_col = dob_cols[0]
+        ref_col = self._detect_reference_date_column(df, exclude=set(dob_cols))
+
+        dob = pd.to_datetime(result_df[dob_col], errors='coerce')
+        if ref_col is not None:
+            ref = pd.to_datetime(result_df[ref_col], errors='coerce')
+            ref = ref.fillna(pd.Timestamp.now())
+        else:
+            ref = pd.Series(pd.Timestamp.now(), index=result_df.index)
+
+        valid = dob.notna() & ref.notna()
+        exact_age = pd.Series(np.nan, index=result_df.index)
+        if valid.any():
+            years = ref.dt.year - dob.dt.year
+            had_birthday = (ref.dt.month > dob.dt.month) | ((ref.dt.month == dob.dt.month) & (ref.dt.day >= dob.dt.day))
+            years = years - (~had_birthday).astype(int)
+            exact_age[valid] = years[valid]
+
+        schema_info = self.schema.get(table_name, {}).get('columns', {})
+
+        for age_col in age_cols:
+            series = result_df[age_col]
+            grouping_config = schema_info.get(age_col, {}).get('age_grouping')
+            looks_bucketed = grouping_config is not None or series.astype(str).str.match(r'^\s*\d+\s*[-+]', na=False).any()
+
+            if looks_bucketed:
+                def year_range_for(label, ref_year):
+                    bounds = self._parse_age_bucket_bounds(label)
+                    if bounds is None or pd.isna(ref_year):
+                        return None
+                    low, high = bounds
+                    max_year = int(ref_year) - low
+                    if high is None:
+                        return f"{max_year - 100}-{max_year}"
+                    min_year = int(ref_year) - high
+                    return f"{min_year}-{max_year}"
+
+                ref_year_series = ref.dt.year
+                new_dob = []
+                for i in range(len(result_df)):
+                    ry = ref_year_series.iloc[i] if valid.iloc[i] else pd.Timestamp.now().year
+                    nd = year_range_for(series.iloc[i], ry)
+                    new_dob.append(nd if nd is not None else result_df[dob_col].iloc[i])
+                result_df[dob_col] = new_dob
+                logging.info(f"Converted '{dob_col}' to a birth-year range consistent with bucketed '{age_col}'")
+            else:
+                recomputed = exact_age.where(valid, self._coerce_numeric(series))
+                result_df[age_col] = recomputed.clip(lower=0, upper=120)
+                try:
+                    result_df[age_col] = result_df[age_col].astype('Int64')
+                except Exception:
+                    pass
+                logging.info(f"Recomputed '{age_col}' from '{dob_col}' to keep them consistent")
+
+        return result_df
+

+    def regenerate_high_cardinality_text_columns(self, df, table_name):
+        """Roadmap item 2: a near-unique free-text column (e.g. an image
+        filename, a free-text description) comes out of the copula with
+        duplicates it shouldn't have, even when the requested row count is
+        at or below the real dataset's size -- confirmed in practice (58
+        unique values out of 100 rows for an "image" column that's 100/100
+        unique in the real data).
+
+        The root cause is that these columns get modeled as generic
+        'categorical' in GaussianCopula: a value is chosen by rounding a
+        continuous quantile to the nearest of ~n category codes, which
+        collides by construction once the number of categories approaches
+        the number of rows -- the birthday-paradox problem, not something
+        any correlation setting fixes. There's also no good generative
+        model for arbitrary free text in the first place.
+
+        Fix: for every 'free text' column (restricted-text/ID columns are
+        already handled, with fresh non-reused values, by
+        regenerate_restricted_text_identifiers), replace the copula's
+        output with values resampled from the real column's own pool,
+        without replacement up to the pool size -- duplicates only appear
+        once more rows are requested than the real data has. All qualifying
+        columns in a table share ONE row permutation rather than each
+        getting its own independent one, so a pair like
+        Picture/Description that's supposed to describe the same thing
+        stays matched instead of being shuffled apart.
+        """
+        schema_info = self.schema.get(table_name, {}).get('columns', {})
+        if not schema_info:
+            return df
+
+        original_df = self.original_data.get(table_name)
+        if original_df is None:
+            return df
+
+        target_cols = [
+            c for c in df.columns
+            if c in schema_info
+            and schema_info[c].get('dmd_type') == 'free text'
+            and not schema_info[c].get('user_protected', False)
+            and c in original_df.columns
+        ]
+        if not target_cols:
+            return df
+
+        result_df = df.copy()
+        n_samples = len(result_df)
+        pool_size = len(original_df)
+        # One shared permutation/sample for every qualifying column in this
+        # table, so linked free-text columns move together.
+        row_map = np.random.choice(pool_size, size=n_samples, replace=n_samples > pool_size)
+
+        for column in target_cols:
+            result_df[column] = original_df[column].iloc[row_map].reset_index(drop=True)
+
+        logging.info(
+            f"Table {table_name}: resampled high-cardinality free-text column(s) {target_cols} "
+            f"from the real value pool without replacement (up to {pool_size} rows) instead of "
+            f"letting the categorical model produce avoidable duplicates"
+        )
+        return result_df

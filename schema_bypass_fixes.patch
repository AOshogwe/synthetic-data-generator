+    def _coerce_numeric(self, series):
+        """Return a numeric-typed version of `series` if it already is one,
+        or if it's numeric-once-formatting-is-stripped (e.g. '$45,231',
+        '87%') -- otherwise None. Use this instead of a raw
+        pd.api.types.is_numeric_dtype() check anywhere a column's *values*
+        (not just its dtype) need to be treated as numbers, so formatted
+        numeric columns like Family Income don't silently fall through to
+        categorical/text handling."""
+        if pd.api.types.is_numeric_dtype(series):
+            return series
+        result = self._numeric_after_stripping(series)
+        if result is not None:
+            return result[0]
+        return None
+
+    def _is_numeric_column(self, series, column_info=None):
+        """Boolean convenience wrapper around _coerce_numeric, additionally
+        trusting the schema's dmd_type (integer/decimal) when it's already
+        been resolved during schema inference."""
+        if column_info and column_info.get('dmd_type') in ('integer', 'decimal'):
+            return True
+        return self._coerce_numeric(series) is not None

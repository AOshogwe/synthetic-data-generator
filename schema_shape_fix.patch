@@ -1939,6 +1939,28 @@ class SyntheticDataPipeline:
                     # 'auto' did this and 'ctgan' (the method app.py's
                     # auto-size-based selection picks for small datasets) was a
                     # silent no-op that always fell through to fallback below.
+                    # SyntheticGenerationEngine/GaussianCopula expect a flat
+                    # {column: {'type': ...}} schema, but self.schema is
+                    # nested per-table ({table: {'columns': {col: {...}}}}).
+                    # Passing the nested dict straight through made every
+                    # column.get(...) lookup miss and silently default to
+                    # 'categorical', regardless of the column's real type --
+                    # confirmed by every column logging as 'categorical'
+                    # even when clearly numeric. Rebuild a flat, table-scoped
+                    # schema here so the model actually sees real types,
+                    # trusting dmd_type for numeric-looking values stored as
+                    # formatted strings (e.g. "$45,231") the same way
+                    # perturb_data already does.
+                    table_columns = self.schema.get(table_name, {}).get('columns', {})
+                    flat_schema = {}
+                    for column in df.columns:
+                        info = table_columns.get(column, {})
+                        col_type = info.get('type', 'categorical')
+                        if info.get('dmd_type') in ('integer', 'decimal'):
+                            col_type = 'numeric'
+                        flat_schema[column] = {'type': col_type}
+                    self.generator.schema = flat_schema
+
                     logging.info(f"Training models (requested method: {method}) on all columns")
                     self.generator.train_models(df)  # Train on the entire dataframe
 
@@ -2291,6 +2313,14 @@ class SyntheticDataPipeline:
         for table_name, synthetic_df in self.synthetic_data.items():
             logging.info(f"Validating table: {table_name}")
 
+            # DataValidator.validate() expects a flat {column: {'type': ...}}
+            # schema, but self.schema is nested per-table -- same shape
+            # mismatch as the generator fix above. Give it this table's flat
+            # column schema so its column-presence/type checks actually
+            # compare against the right thing instead of silently failing
+            # every column-presence check.
+            self.validator.schema = self.schema.get(table_name, {}).get('columns', {})
+
             # Validate against schema and constraints
             issues = self.validator.validate(synthetic_df)
 

+# jsonify() (Flask's default JSON provider) only knows plain Python types.
+# Pipeline/evaluation results are built from pandas/numpy computations --
+# df[col].count(), .sum(), .mean(), .min()/.max() on a datetime column, etc.
+# -- which hand back np.int64/np.float64/np.bool_/pd.Timestamp/NaT rather
+# than the plain int/float/str jsonify expects, so any route returning
+# those values directly (e.g. /api/evaluate's evaluation_results) raises
+# "Object of type int64 is not JSON serializable" instead of actually
+# responding. Registering this converter once, app-wide, fixes it for
+# every route rather than requiring each one to sanitize its own response.
+class NumpyCompatJSONProvider(DefaultJSONProvider):
+    @staticmethod
+    def default(obj):
+        if isinstance(obj, np.integer):
+            return int(obj)
+        if isinstance(obj, np.floating):
+            return float(obj)
+        if isinstance(obj, np.bool_):
+            return bool(obj)
+        if isinstance(obj, np.ndarray):
+            return obj.tolist()
+        if obj is pd.NaT:
+            return None
+        if isinstance(obj, (pd.Timestamp, datetime)):
+            return obj.isoformat()
+        if isinstance(obj, pd.Series):
+            return obj.tolist()
+        return DefaultJSONProvider.default(obj)
+
+
+app.json = NumpyCompatJSONProvider(app)

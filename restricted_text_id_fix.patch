+    def _generate_fresh_restricted_text_values(real_values, n):
+        """Generate `n` fresh ID-like values that look like `real_values`
+        (same alpha-prefix + zero-padded-number shape when one is detected,
+        otherwise the same letter/digit/other character pattern as a sample
+        value) but are guaranteed not to equal any value in `real_values`,
+        and are unique among themselves.
+
+        This exists to fix task #48: GaussianCopula/CTGAN's categorical
+        handling, the perturbation path's category-swap, and the column
+        abstraction methods all resample restricted-text/ID columns from
+        the *exact set* of real observed values. That's correct for a
+        genuine category like 'Sex' (there's nothing identifying about
+        'Male' or 'Female' on their own), but for a near-unique ID column
+        every 'category' IS one specific real person's identifier -- so
+        resampling just reattaches a real person's real ID to a different,
+        fabricated row. That's the opposite of anonymization: it discloses
+        that the real ID was in the dataset at all (membership disclosure)
+        and falsely links it to fabricated data.
+        """
+        import random
+        import string
+
+        real_values = {str(v) for v in real_values if pd.notna(v)}
+
+        id_pattern = re.compile(r'^([A-Za-z]{1,4}-?)(\d+)$')
+        matches = [id_pattern.match(v) for v in real_values]
+        decomposed = [(m.group(1), len(m.group(2))) for m in matches if m]
+
+        # A clean "prefix + zero-padded number" scheme (e.g. 'T001') covers
+        # most of the real values -- keep that exact format, just count
+        # past every number actually used so nothing collides.
+        if decomposed and len(decomposed) >= max(1, len(real_values) * 0.8):
+            from collections import Counter
+            prefix, width = Counter(decomposed).most_common(1)[0][0]
+            max_seen = max(
+                (int(m.group(2)) for m in matches if m and m.group(1) == prefix),
+                default=0
+            )
+            values = []
+            next_num = max_seen + 1
+            for _ in range(n):
+                values.append(f"{prefix}{str(next_num).zfill(width)}")
+                next_num += 1
+            return values
+
+        # No clean numeric scheme -- generate random values matching the
+        # letter/digit/other character pattern of a sample value, rejecting
+        # any collision with a real value or one already used in this batch.
+        sample = next(iter(real_values), 'ID0000000')
+        char_pattern = [
+            'A' if c.isalpha() and c.isupper() else
+            'a' if c.isalpha() else
+            '9' if c.isdigit() else c
+            for c in sample
+        ]
+
+        def make_candidate():
+            out = []
+            for c in char_pattern:
+                if c == 'A':
+                    out.append(random.choice(string.ascii_uppercase))
+                elif c == 'a':
+                    out.append(random.choice(string.ascii_lowercase))
+                elif c == '9':
+                    out.append(random.choice(string.digits))
+                else:
+                    out.append(c)
+            return ''.join(out)
+
+        values = []
+        seen = set()
+        attempts = 0
+        max_attempts = n * 200 + 1000
+        while len(values) < n and attempts < max_attempts:
+            attempts += 1
+            candidate = make_candidate()
+            if candidate in real_values or candidate in seen:
+                continue
+            seen.add(candidate)
+            values.append(candidate)
+        # Extremely unlikely fallback if the pattern's value space is too
+        # small to fit n unique non-colliding candidates.
+        while len(values) < n:
+            values.append(f"SYN-{len(values) + 1:08d}")
+        return values
+
